# ==============================================================================
# LOCALHUB SAAS - ENVIRONMENT CONFIGURATION (SUPABASE)
# ==============================================================================

# SUPABASE_URL: Project URL from your Supabase project dashboard (e.g., https://your-project.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_PUBLISHABLE_KEY: Public/Anon API key (safe for browser and public clients)
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# SUPABASE_SECRET_KEY: Secret Service Role key (STRICTLY SERVER-SIDE - never expose to frontend)
SUPABASE_SECRET_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# APP_BASE_DOMAIN & VITE_APP_BASE_DOMAIN: Custom base domain for dynamic multi-tenant subdomains
# Generates tenant URLs in the format: https://{slug}.minihub.tech
APP_BASE_DOMAIN="minihub.tech"
VITE_APP_BASE_DOMAIN="minihub.tech"

# APP_URL: Base URL where this application is hosted
APP_URL="https://minihub.tech"

# NODE_ENV: Runtime environment (development | production)
NODE_ENV="development"
